# ===================================================
# Luna Beauty — Environment Variables
# Copy this file to .env.local and fill in your values
# ===================================================

# ── Supabase ────────────────────────────────────────
# Create a project at https://supabase.com
# Find these in: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Anthropic (Claude AI) ───────────────────────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ── Amazon Associates ───────────────────────────────
# Sign up at https://affiliate-program.amazon.com
# Replace with your actual Associates tracking ID
NEXT_PUBLIC_AMAZON_TAG=lunabeauty-20

# ── App Config ──────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Luna Beauty

# ── Rate Limiting ───────────────────────────────────
# Max AI chat requests per user per minute
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# ── Analytics ───────────────────────────────────────
# Optional: Vercel Analytics is zero-config on Vercel
# VERCEL_ANALYTICS_ID is auto-injected by Vercel

# ── Optional: Admin Password for /admin/analytics ───
ADMIN_SECRET=your-admin-secret-here
